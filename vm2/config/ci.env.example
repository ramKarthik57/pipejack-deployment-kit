# PipeJack CI Server configuration
# Loaded by /etc/systemd/system/pipejack-ci.service

# Path to the CI server binary
PIPEJACK_BIN=/usr/local/bin/pipejack-ci

# Working directory (where policy files and Dockerfiles live)
PIPEJACK_WORKDIR=/home/ubuntu/custom-ci

# HTTP listen port
PIPEJACK_PORT=8888

# Enable policy enforcement (BLOCK fails the build)
PIPEJACK_ENFORCE=1

# Fast mode: skip Docker build/push/deploy (0 = full pipeline)
PIPEJACK_FAST=0

# Dev mode: skip Maven, run attack.sh directly (0 = real build)
PIPEJACK_DEV=0
