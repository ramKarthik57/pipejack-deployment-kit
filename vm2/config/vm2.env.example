# PipeJack VM2 Master Environment Configuration Example
# Place at /etc/pipejack/vm2.env or source in administrative shells

# VM2 Private Interface Address (for inter-VM communication with VM1)
VM2_BIND_IP="0.0.0.0"
VM2_ADVERTISED_IP="192.168.88.133"

# Ports
PIPEJACK_CI_PORT=8888
PIPEJACK_CONSOLE_PORT=8090
PIPEJACK_REGISTRY_PORT=5000

# Base Directories
PIPEJACK_WORKDIR="/home/ubuntu/custom-ci"
PIPEJACK_CONSOLE_DIR="/home/ubuntu/pipejack-demo-console"
PIPEJACK_ATTEST_DIR="/home/ubuntu/pipejack-attestations"
PIPEJACK_KEY_PATH="/home/ubuntu/.pipejack/attest-key"

# Enforcement: 1 = Enforce BLOCK policies, 0 = Detection only
PIPEJACK_ENFORCE=1

# Fast Mode: 1 = Skip docker push/deploy, 0 = Full pipeline
PIPEJACK_FAST=0

# Dev Mode: 1 = Run attack.sh directly, 0 = Real build pipeline
PIPEJACK_DEV=0
