# PipeJack VM1 Client Environment Configuration Example
# Copy to ~/.pipejack/vm1.env or load via .bashrc

# IP or hostname of VM2
VM2_HOST="192.168.88.133"

# Port on VM2 where the CI server listens
VM2_PORT="8888"

# CI endpoint for pipejack-upload.sh and attacks/run-all.sh
CI_ENDPOINT="http://${VM2_HOST}:${VM2_PORT}/upload"

# Base directory where PipeJack workloads are installed on VM1
PIPEJACK_HOME="${HOME}"

# Optional verbose logging for upload client (0 = standard, 1 = verbose)
PIPEJACK_VERBOSE=0
