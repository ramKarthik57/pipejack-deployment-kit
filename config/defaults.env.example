# PipeJack Deployment Kit — Master Default Environment Variables
# Copy to custom .env file or reference during deployment

# Node IP Addresses (Default VMware Lab Topology)
PIPEJACK_VM1_IP="192.168.88.132"
PIPEJACK_VM2_IP="192.168.88.133"

# Default SSH User
PIPEJACK_SSH_USER="ubuntu"
PIPEJACK_SSH_PORT=22

# Service Ports on VM2
PIPEJACK_CI_PORT=8888
PIPEJACK_CONSOLE_PORT=8090
PIPEJACK_REGISTRY_PORT=5000

# CI Endpoint URL for VM1 Uploaders
PIPEJACK_CI_ENDPOINT="http://${PIPEJACK_VM2_IP}:${PIPEJACK_CI_PORT}/upload"

# Security & Pipeline Modes
# 1 = Policy enforcement active (BLOCK terminates build with HTTP 403)
# 0 = Detection only mode (verdict recorded in attestation ledger without blocking)
PIPEJACK_ENFORCE=1

# 0 = Run complete container build, test, and registry push
# 1 = Fast mode (skips heavy docker push/deploy for rapid testing)
PIPEJACK_FAST=0

# 0 = Run real build system (Maven / npm / pip)
# 1 = Dev test mode (execute attack payload script directly)
PIPEJACK_DEV=0
